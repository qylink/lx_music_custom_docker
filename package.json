{
  "name": "lx-music-docker",
  "version": "1.5.0",
  "description": "洛雪音乐 Docker 版 - 在 NAS / 飞牛 OS 上导入网易云歌单、添加自定义音源、批量下载歌曲",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/multipart": "^8.3.0",
    "music-metadata": "^7.14.0",
    "pinyin": "^4.0.0",
    "iconv-lite": "^0.6.3"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
