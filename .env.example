# =====================================================
# LX Music Docker · 飞牛 OS 部署环境变量（模板）
# -----------------------------------------------------
# 在飞牛上：
#   1) cp .env.example .env
#   2) vim .env   把 MUSIC_BIND 改成 /vol1/1000/music/lx 之类
#   3) docker compose up -d
# =====================================================

# 容器名（在飞牛 Docker UI 中显示的名字）
APP_NAME=lx-music-docker

# 镜像地址（默认走 Docker Hub：qylinkdc/lx_music_custom_docker）
# 本地源码构建：docker compose up -d --build（无需改此行）
# 用私有仓库/局域网镜像：改成你的镜像地址，例如 registry.example.com:5000/lx-music-docker:1.5.0
LX_IMAGE=qylinkdc/lx_music_custom_docker:1.5.0

# Web UI 端口（容器内监听端口，host 网络模式下即宿主端口）
HTTP_PORT=3210

# 时区，影响下载时间戳与文件名排序
TZ=Asia/Shanghai

# ----------------- 数据目录（飞牛推荐用 /vol1 实际卷） -----------------
# ./data 表示 docker-compose.yml 所在目录的 data/ 子文件夹
# 也可以改为 /vol1/1000/docker/lx-music-docker/data 这种绝对路径
DATA_BIND=./data

# 下载音乐独立挂载到 NAS 的音乐目录，便于飞牛相册 / Plex / 内置播放器读取
# 推荐：/vol1/1000/music/lx
MUSIC_BIND=./data/music

# 音源脚本独立挂载（方便用 SMB / 文件管理直接拖入 .js）
# 推荐：/vol1/1000/docker/lx-music-docker/sources
SOURCES_BIND=./data/sources

# ----------------- 下载参数 -----------------
DOWNLOAD_CONCURRENCY=3
DOWNLOAD_QUALITY=320
DOWNLOAD_TIMEOUT=90000

# ----------------- 网易云 -----------------
# 浏览器 cookie 里的 MUSIC_U；填了可解析私享歌单，不填也能解析公开歌单
NETEASE_MUSIC_U=
# 解析时使用的 User-Agent，触发风控时可调整
NETEASE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# ----------------- 调试 -----------------
LOG_LEVEL=info
